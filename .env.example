# Neon Postgres — pooled (for serverless) and direct (for migrations/imports)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk (frontend + backend + webhook signature)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Groq (LLM) — OpenAI OSS family on Groq. Primary is the smaller
# 20b (fast, reliable JSON); fallback is the heavier 120b for when
# the small one returns parse-failing output.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_FALLBACK_MODEL=openai/gpt-oss-120b

# Free-tier friendly ceilings — keep below Groq's published limits
GROQ_RPM_CEILING=25
GROQ_TPM_CEILING=7000
GROQ_TPD_CEILING=180000

# Web search grounding (Serper primary, Tavily fallback)
SERPER_API_KEY=
TAVILY_API_KEY=
SEARCH_DAILY_CEILING=40

# Vercel Blob for uploads
BLOB_READ_WRITE_TOKEN=

# Resend transactional email
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@herbyte.com

# Comma-separated verified admin emails (case-insensitive)
ADMIN_EMAILS=

# Random secret for /api/cron/* endpoints (Vercel Cron sends it in Authorization)
CRON_SECRET=

# The old media host, used only by scripts/rehost-media.ts
LEGACY_MEDIA_HOST=base44.app

# Auto-publish rule: when the AI moderator returns "Approved" with risk
# Low or Moderate, the submission is published immediately — no admin
# click required. Admin review is still enforced for anything Pending /
# Flagged / High / Critical. Set "false" to require admin publish on
# every submission (slower, but adds a second pair of eyes to every
# entry). Default: true.
AUTO_PUBLISH_APPROVED=true

# -----------------------------------------------------------------------------
# Content agent (scripts/generate-content.ts + /api/cron/run-agent)
# -----------------------------------------------------------------------------
# Shared secret the agent sends in X-Agent-Service-Token to authenticate
# as AGENT_AUTHOR_EMAIL without going through Clerk. Generate once with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Set this in Vercel (Production) too — the cron endpoint uses it to
# submit in-process via the same path as the CLI.
AGENT_SERVICE_TOKEN=
AGENT_AUTHOR_EMAIL=olagunjuafeez@gmail.com
AGENT_AUTHOR_NAME=Olagunju Afeez

# Stock photos — Unsplash. Register an app at https://unsplash.com/developers
# then paste the Access Key here. Without this the agent still submits
# entries, just without an image_url.
UNSPLASH_ACCESS_KEY=

# Limits — easy to change without editing code.
# Daily cap is enforced by querying the DB for today's agent submissions,
# so it holds across any invocation path (local CLI, Vercel Cron, re-runs).
AGENT_DAILY_CAP=12
AGENT_RESEARCH_RATIO=0.5

# Where the CLI POSTs submissions. Default is the production domain;
# set to http://localhost:3000 to point at a local `vercel dev`. Unused
# by the cron endpoint — the cron submits in-process via app.fetch.
AGENT_API_BASE=https://herbyte.cereustechnologies.com
